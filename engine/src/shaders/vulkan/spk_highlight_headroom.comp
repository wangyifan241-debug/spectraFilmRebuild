#version 450

// Direct port of nodes.metal::spk_highlight_headroom. One invocation owns a
// packed RGB pixel; the common gain preserves the light's channel ratios.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float value[]; } input_data;
layout(set = 0, binding = 1, std430) readonly buffer Parameters { float value[]; } parameters;
layout(set = 0, binding = 2, std430) readonly buffer Count { uint value[]; } count_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output { float value[]; } output_data;

float smoothstep01(float t) {
    t = clamp(t, 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

void main() {
    // Folded dispatches use the same 1-D index as the other Vulkan kernels.
    uint i = gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
    if (i >= count_data.value[0]) return;
    vec3 v = vec3(input_data.value[3*i], input_data.value[3*i+1], input_data.value[3*i+2]);
    float m = max(v.x, max(v.y, v.z));
    float gain = 1.0;
    if (m > 0.0) {
        float lm = log2(m);
        float near_clip = smoothstep01((lm + log2(parameters.value[0]) - parameters.value[1]) * parameters.value[2]);
        float over_floor = smoothstep01((lm + log2(parameters.value[4]) - parameters.value[5]) * parameters.value[6]);
        gain = exp2(parameters.value[3] * near_clip * over_floor);
    }
    output_data.value[3*i] = v.x * gain;
    output_data.value[3*i+1] = v.y * gain;
    output_data.value[3*i+2] = v.z * gain;
}
