#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer Input { float f[]; };
layout(set=0,binding=1,std430) readonly buffer Parameters { float P[]; };
layout(set=0,binding=2,std430) readonly buffer Count { uint n[]; };
layout(set=0,binding=3,std430) writeonly buffer Output { float dst[]; };
uint spk_global_index() {
    return gl_GlobalInvocationID.y*(gl_NumWorkGroups.x*gl_WorkGroupSize.x)+gl_GlobalInvocationID.x;
}
#include "overscan.glsl"
void main() {
    const uint i = spk_global_index();
    if (i >= n[0]) return;
    const uint cw = uint(P[P_CW]);
    precise vec2 st = canvas_to_film(float(i % cw), float(i / cw));
    precise float W = P[P_FILM_W];
    vec3 e = vec3(0.0f);
    if (P[P_CARRIER] > 1.5f || (st.y >= 0.0f && st.y <= W)) {
        // A pair: past the middle of the gap, the second exposure of the same gate.
        vec2 sg = st;
        float shift = 0.0f;
        if (P[P_PAIR_ADV] > 0.0f && st.x > P[P_GS0] + 0.5f * (P[P_GW] + P[P_PAIR_ADV])) { shift = P[P_PAIR_ADV]; sg.x -= shift; }
        precise float cov = penumbra(gate_sdf(sg), P[P_PENUMBRA]);
        if (cov > 0.0f) {
            precise float px = P[P_PX];
            float fx, fy;
            if (P[P_VERTICAL] < 0.5f) { fx = (st.x - P[P_GS0]) / px - 0.5f; fy = (st.y - P[P_GT0]) / px - 0.5f; }
            else                      { fx = (P[P_GT0] + P[P_GH] - st.y) / px - 0.5f; fy = (st.x - P[P_GS0]) / px - 0.5f; }
            e += cov * sample_frame(fx, fy, uint(P[P_FW]), uint(P[P_FH]));
        }
        // Gate flare: the gate's bevelled edge reflects scene light onto the
        // film just outside the frame -- a thin line that follows the scene's
        // brightness along the edge (bright sky, bright line).
        precise float d_gate = gate_sdf(sg);
        if (P[P_FLARE_AMP] > 0.0f && d_gate > -0.02f && d_gate < 6.0f * P[P_FLARE_WIDTH]) {
            precise float px = P[P_PX];
            precise float in_s = clamp(sg.x, P[P_GS0] + 0.12f, P[P_GS0] + P[P_GW] - 0.12f) + shift;
            precise float in_t = clamp(st.y, P[P_GT0] + 0.12f, P[P_GT0] + P[P_GH] - 0.12f);
            float fx, fy;
            if (P[P_VERTICAL] < 0.5f) { fx = (in_s - P[P_GS0]) / px - 0.5f; fy = (in_t - P[P_GT0]) / px - 0.5f; }
            else                      { fx = (P[P_GT0] + P[P_GH] - in_t) / px - 0.5f; fy = (in_s - P[P_GS0]) / px - 0.5f; }
            precise vec3 edge_light = sample_frame(fx, fy, uint(P[P_FW]), uint(P[P_FH]));
            precise float prof = exp(-max(d_gate, 0.0f) / P[P_FLARE_WIDTH]);
            e += P[P_FLARE_AMP] * prof * edge_light;
        }
        // Edge fog: warm exposure decaying inward from each long edge, slowly
        // varying along the length; and the spool leaks, seeded blobs on an edge.
        // (clamped: the canvas reaches past the film, where there is none to fog)
        precise float d_top = max(st.y, 0.0f), d_bot = max(W - st.y, 0.0f);
        const uint seed = uint(P[P_FOG_SEED]);
        precise float period = max(P[P_FOG_PERIOD], 0.1f);
        precise float nz = 0.6f * value_noise(st.x / period, seed) +
                         0.4f * value_noise(st.x / (0.37f * period), seed ^ 0xA5A5A5A5u);
        float fog = P[P_FOG_AMP] * exp(-min(d_top, d_bot) / max(P[P_FOG_WIDTH], 1e-3f)) * (0.3f + 0.7f * nz);
        const uint nl = uint(P[P_N_LEAKS]);
        for (uint k = 0; k < nl; ++k) {
            const uint b = P_LEAKS + 5u * k;
            precise float dd = P[b + 1u] < 0.5f ? d_top : d_bot;
            precise float ds = st.x - P[b];
            fog += P[b + 2u] * exp(-ds * ds / (2.0f * P[b + 3u] * P[b + 3u])) * exp(-dd / P[b + 4u]);
        }
        e += fog * vec3(P[P_FOG_R], P[P_FOG_G], P[P_FOG_B]);
    }
    dst[3u * i] = e.x;
    dst[3u * i + 1u] = e.y;
    dst[3u * i + 2u] = e.z;
}
