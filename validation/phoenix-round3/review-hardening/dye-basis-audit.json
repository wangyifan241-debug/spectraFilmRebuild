    "engine/tools/bake_resources.py copy_json copies reference package JSON byte-for-byte",
    "engine/resources_research/build-phoenix.cjs copies Gold channel_density, substitutes null->0",
    "engine/src/core/profile.cpp subtracts per-channel characteristic minima; actual GPU coefficient observed after film_grain",
    "engine/src/core/spectral.cpp zeroes whole invalid spectral rows and their integration weights"
